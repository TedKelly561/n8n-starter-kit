{
  "id": "KitErrorAlert001",
  "name": "Error Alert",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Error Alert (fail to a person)\nAny workflow that sets **Settings > Error workflow = Error Alert** sends its failures here.\nThe message goes to `ALERT_WEBHOOK_URL` (Slack or Discord incoming webhook) from `.env`.\nIf no channel is set, this workflow fails on purpose so the problem is visible.",
        "width": 520,
        "height": 200
      },
      "id": "811421ce-f472-57bf-a1f5-e77fe31c7b15",
      "name": "Note err-note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "2ccd4eca-3bca-5bbf-897d-9d9aed1699af",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build one plain-language message for a person.\nconst e = $input.first().json;\nconst wf = e.workflow || {};\nconst ex = e.execution || {};\nconst trig = e.trigger || {};\nconst err = ex.error || trig.error || {};\nconst node = ex.lastNodeExecuted || (err.node && err.node.name) || 'unknown node';\nconst base = String($env.KIT_PUBLIC_URL || '').replace(/\\/$/, '');\nconst link = ex.url || (ex.id && wf.id ? `${base}/workflow/${wf.id}/executions/${ex.id}` : 'no execution was saved (trigger error)');\nconst lines = [\n  `n8n workflow FAILED: ${wf.name || 'unknown workflow'}`,\n  `Node: ${node}`,\n  `Error: ${err.message || 'no message'}`,\n  err.description ? `Details: ${err.description}` : null,\n  `Execution: ${link}`,\n  `Mode: ${ex.mode || 'unknown'}${ex.retryOf ? ` (retry of ${ex.retryOf})` : ''}`,\n  'The item was not dropped: it is in the execution above. Fix the cause, then retry the execution.',\n].filter(Boolean);\nreturn [{ json: { text: lines.join('\\n'), workflow: wf.name, node, error: err.message || null, link,\n                  hasChannel: Boolean($env.ALERT_WEBHOOK_URL) } }];"
      },
      "id": "06c6adff-67fd-54a7-85e2-d02673f1fb8a",
      "name": "Build message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0b83ff94-cdd0-5980-b6bd-cc804f1b6cf3",
              "leftValue": "={{ $json.hasChannel }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9c8db704-ae3b-5ca2-899a-3474cd2ce4c3",
      "name": "Alert channel set?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.text }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a564aeb9-a44d-5c86-a6b5-519372b5b4c1",
      "name": "Send to person (Slack/Discord)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
