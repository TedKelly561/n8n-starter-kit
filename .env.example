# n8n starter kit settings.
# ./setup.sh copies this file to .env (chmod 600) and fills in the secrets.
# Never commit .env. Placeholders below use example.com on purpose.

# ---------------------------------------------------------------- versions
# Pinned on purpose. Change N8N_VERSION only with ./scripts/update.sh <tag>.
N8N_VERSION=2.46.6
POSTGRES_VERSION=17.11-alpine
CADDY_VERSION=2.11.9-alpine
UPTIME_KUMA_VERSION=2.5.9-slim
COMPOSE_PROJECT_NAME=n8nkit

# ---------------------------------------------------------------- address
# Production: a hostname with a DNS A record pointing at this server.
DOMAIN=n8n.example.com
PUBLIC_URL=https://n8n.example.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
# What Caddy serves. Production: the bare domain (automatic HTTPS).
# Local mode: ":80" (any hostname, plain HTTP, no certificate)
CADDY_SITE_ADDRESS=n8n.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.com
# Host ports and bind address. Local mode binds to 127.0.0.1 only.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Set to true by ./setup.sh --local (skips certificate checks, plain HTTP).
LOCAL_MODE=false

# ---------------------------------------------------------------- time
GENERIC_TIMEZONE=UTC

# ---------------------------------------------------------------- secrets (generated by setup.sh)
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=
# Read-only database role used by the Daily Health Digest workflow.
POSTGRES_READONLY_USER=n8n_readonly
POSTGRES_READONLY_PASSWORD=
# STORE THIS IN A PASSWORD MANAGER. Without it, credential backups are useless.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------- safety method
# true = workflows log what they WOULD do instead of doing it (shadow mode).
# Switch to false only after the shadow log has matched reality for a while.
SHADOW_MODE=true
# Executions older than this many hours are pruned (336 h = 14 days).
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000

# ---------------------------------------------------------------- alerts (fail to a person)
# Slack or Discord incoming webhook. Used by healthcheck.sh and the n8n
# Error Alert / Daily Health Digest workflows.
ALERT_WEBHOOK_URL=
# Email alerts from the host scripts (needs msmtp or sendmail configured).
ALERT_EMAIL=
# Re-send an unresolved alert after this many hours (0 = only once).
ALERT_REPEAT_HOURS=24

# ---------------------------------------------------------------- heartbeats (e.g. Healthchecks.io)
# Pinged after each successful backup; "<url>/fail" on failure.
HEARTBEAT_URL=
# Pinged by healthcheck.sh every 5 minutes; "<url>/fail" on problems.
HEALTH_HEARTBEAT_URL=
# Pinged by the weekly restore drill.
DRILL_HEARTBEAT_URL=

# ---------------------------------------------------------------- backups
# Relative paths are relative to the kit folder.
BACKUP_DIR=./data/backups
HISTORY_DIR=./data/history
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Alert if the newest good backup is older than this.
BACKUP_MAX_AGE_HOURS=26
# Encrypt a copy of .env into each backup. Set ONE of these, or the .env copy
# is skipped (with a warning). age is preferred: put a public key here and keep
# the private key off this server.
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_PASSPHRASE=
# Optional off-site copy with rclone, e.g. "b2:my-bucket/n8n" (run rclone config first).
RCLONE_REMOTE=

# ---------------------------------------------------------------- health thresholds
DISK_WARN_PERCENT=85
CERT_WARN_DAYS=14

# ---------------------------------------------------------------- optional monitoring profile
MONITORING_ENABLED=false
MONITORING_SUBDOMAIN=status
